# Backend Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
SERVER_MODE=development

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gosvelte
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL_MODE=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# OAuth Configuration (Optional - for Authentik integration)
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback
# AUTHENTIK_URL=http://authentik-server:9000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# Logging
LOG_LEVEL=debug

# Frontend Path (for embedded mode)
FRONTEND_BUILD_PATH=./src/assets/frontend